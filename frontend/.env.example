# ─── Copy this file to .env.local and fill in your real values ────────────────
# NEVER commit .env.local — it is in .gitignore

# Supabase (get from: https://supabase.com/dashboard/project/dmgxkdzoakruulqtfskc/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://dmgxkdzoakruulqtfskc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# VAPI (get from: https://dashboard.vapi.ai → API Keys)
# Web Token = Public Key (safe for browser)
NEXT_PUBLIC_VAPI_WEB_TOKEN=your_vapi_web_token_here
# Assistant ID (create assistant first, then copy the ID here)
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# n8n Webhook base URL (no trailing slash)
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://cohort2pod2.app.n8n.cloud/webhook
